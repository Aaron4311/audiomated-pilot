<Window x:Class="Audio.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Audio.GUI"
        mc:Ignorable="d"
        Title="Audiomated Pilot" Height="520" Width="780" Icon="icon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Playback" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="PlaybackPanel" Margin="8"/>
                </ScrollViewer>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Recording" Margin="6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="RecordingPanel" Margin="8"/>
                </ScrollViewer>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Communication" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="CommunicationPanel" Margin="8"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Name="ProfileComboBox" Width="160" Margin="0,0,6,0"/>
            <TextBox Name="ProfileNameTextBox" Width="140" Margin="0,0,6,0" ToolTip="New profile name"/>
            <Button Content="Save Profile" Click="SaveProfile_Click" Margin="0,0,6,0" Padding="8,2"/>
            <Button Content="Load Profile" Click="LoadProfile_Click" Margin="0,0,6,0" Padding="8,2"/>
            <Button Content="Delete Profile" Click="DeleteProfile_Click" Padding="8,2"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Apply" Width="90" Click="Apply_Click" Margin="0,0,6,0" Padding="8,4" FontWeight="Bold"/>
            <Button Content="Refresh Devices" Click="Refresh_Click" Margin="0,0,6,0" Padding="8,4"/>
            <Button Content="Import" Click="Import_Click" Margin="0,0,6,0" Padding="8,4"/>
            <Button Content="Export" Click="Export_Click" Padding="8,4"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Name="StatusText" Margin="0,8,0,0" Foreground="DimGray"/>
    </Grid>
</Window>
